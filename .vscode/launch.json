{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行（中文版）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/uber_tool.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "运行（英文版）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/uber_tool.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["--lang", "en"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "运行（演示数据，不联网）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/uber_tool.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["--demo-data"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "运行（演示：日历弹窗）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/uber_tool.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["--demo-calendar"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "自检（不联网）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_ui.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  ]
}
